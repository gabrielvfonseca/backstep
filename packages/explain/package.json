{
  "name": "value-lineage",
  "version": "0.0.0",
  "description": "Explain how a value got into an unexpected state. Records the lineage of array pipelines and reports the step where the result diverged.",
  "keywords": [
    "debug",
    "debugging",
    "trace",
    "lineage",
    "provenance",
    "array",
    "pipeline",
    "data-flow"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./transform": {
      "import": {
        "types": "./dist/transform.d.ts",
        "default": "./dist/transform.js"
      },
      "require": {
        "types": "./dist/transform.d.cts",
        "default": "./dist/transform.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.ts",
        "default": "./dist/esbuild.js"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "check:package": "publint --strict && attw --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "@explain/tsconfig": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "@babel/parser": "^8.0.7",
    "esbuild": "^0.28.2",
    "@types/node": "^24.0.0"
  },
  "peerDependencies": {
    "@babel/parser": ">=7.20.0",
    "esbuild": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "@babel/parser": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  }
}
