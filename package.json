{
  "name": "backstep-monorepo",
  "private": true,
  "scripts": {
    "bench": "turbo run bench",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "biome check . && turbo run typecheck test",
    "check:all": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check:package",
    "check:package": "turbo run check:package",
    "clean": "turbo run clean && rm -rf node_modules",
    "fix": "ultracite fix",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepare": "lefthook install || true",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "^3.0.3",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "~7.0.2",
    "ultracite": "8.0.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
