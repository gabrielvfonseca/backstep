{
  "name": "explain-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "check:package": "turbo run check:package",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules",
    "check": "biome check . && turbo run typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
